void topMenu() {
  u8g2.setFont(soundpod_icon_pack_font);

  if (volume >= 25)
    u8g2.drawGlyph(119, 9, 77);
  else if (volume > 10 && volume < 25)
    u8g2.drawGlyph(119, 9, 78);
  else if (volume <= 10)
    u8g2.drawGlyph(119, 9, 79);
